/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-25",
	"observability": {
		"enabled": true
	},

	/**
	 * D1 Database Configuration
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-db-prod",
			"database_id": "63eacc55-204a-4d50-b2a9-0ff3fbbef46b"
		}
	],

	/**
	 * KV Namespace for caching
	 */
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "cdc1516d100c43f49116a2572d8d8ded"
		}
	],
	/**
	 * Environment Variables
	 *
	 * JWT_SECRET 是 secret（不在 vars 中定义）：
	 * - 本地开发: 在 .dev.vars 写入 JWT_SECRET=<随机强密钥>（已被 .gitignore 忽略）
	 * - 生产部署: npx wrangler secret put JWT_SECRET
	 * - 测试: vitest.config.mts 的 miniflare bindings 注入
	 */
	"vars": {
		"NODE_ENV": "development",
		"ALLOWED_ORIGINS": ""
	}

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
}
