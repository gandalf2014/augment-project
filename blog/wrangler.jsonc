/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-25",
	"observability": {
		"enabled": true
	},

	/**
	 * D1 Database Configuration
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-db-prod",
			"database_id": "63eacc55-204a-4d50-b2a9-0ff3fbbef46b"
		}
	],

	/**
	 * KV Namespace for caching
	 */
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "cdc1516d100c43f49116a2572d8d8ded"
		}
	],
	/**
	 * Environment Variables
	 *
	 * JWT_SECRET is injected as a secret; never hardcode it here:
	 * - Local dev: put JWT_SECRET=<random strong key> in .dev.vars (git-ignored)
	 * - Production: npx wrangler secret put JWT_SECRET
	 * "{JWT_SECRET}" is wrangler's secret-placeholder syntax, resolved from secrets / .dev.vars at deploy.
	 */
"vars": {
		"JWT_SECRET": "{JWT_SECRET}",
		"NODE_ENV": "development",
		"ALLOWED_ORIGINS": ""
	}

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
}
